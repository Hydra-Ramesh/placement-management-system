# Flask Environment
FLASK_ENV=development
FLASK_APP=src.app:create_app
PORT=5000

# Security & Secrets
SECRET_KEY=replace_with_a_secure_random_string_in_production
JWT_SECRET_KEY=replace_with_a_secure_jwt_key_in_production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (Neon Serverless PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_nCVKtBg2dhM4@ep-blue-wave-b3o5k41a-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Database Connection Pooling Options (Neon Serverless & Render optimization)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# CORS Configuration (Set to Vercel production domain or * for local dev)
CORS_ORIGIN=*

# Uploads Folder (Local fallback)
UPLOAD_FOLDER=uploads

# Cloudinary Cloud Storage (Recommended for Production / Render)
# You can provide either CLOUDINARY_URL or the 3 keys individually:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
